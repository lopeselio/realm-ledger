{
  "name": "@realm-ledger/verify",
  "version": "0.1.0",
  "description": "Checks a Realm Ledger campaign proof bundle with no API key: seals, replay, state hashes, and the TEE model's signed replies.",
  "license": "MIT",
  "type": "module",
  "exports": { ".": "./src/index.ts" },
  "bin": { "realm-verify": "./src/cli.ts" },
