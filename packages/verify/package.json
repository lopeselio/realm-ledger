    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "verify": "tsx src/cli.ts"
  },
  "dependencies": {
    "@noble/curves": "2.3.0",
    "@noble/hashes": "2.4.0",
    "@realm-ledger/rules": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
